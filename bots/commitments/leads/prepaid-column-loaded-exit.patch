@@ -0,0 +1,62 @@
+#pragma once
+#include "contract.h"
+#include <type_traits>
+
+namespace p9::live {
+template<class Policy>
+inline constexpr bool loaded_capture_exit_enabled=[] {
+    if constexpr(requires {Policy::bank_blocked_capture();})return bool(Policy::bank_blocked_capture());
+    else return false;
+}();
+struct LoadedCaptureExitState {bool active=false;};
+struct EmptyLoadedCaptureExitState {};
+template<class Policy>
+using LoadedCaptureExitMemory=std::conditional_t<loaded_capture_exit_enabled<Policy>,
+    LoadedCaptureExitState,EmptyLoadedCaptureExitState>;
+
+// ThreatRange is the caller's current visible/alive actor cache. Original
+// spawn occupancy, not attack radius or damage, is the capture obstruction.
+// Both the actor and the rival must occupy an original spawn of this group.
+template<class SpawnRange,class ThreatRange>
+constexpr bool capture_has_enemy_occupant(Point self,const SpawnRange& spawns,const ThreatRange& threats) {
+    bool self_on_spawn=false;
+    for(const auto& spawn:spawns)if(self.x==spawn.x&&self.y==spawn.y) {self_on_spawn=true;break;}
+    if(!self_on_spawn)return false;
+    for(const auto& threat:threats)if(threat.enemy)
+        for(const auto& spawn:spawns)
+            if(threat.position.x==spawn.x&&threat.position.y==spawn.y)return true;
+    return false;
+}
+
+// Called before automatic capture and policy dispatch. In observe(), an active
+// hold is the productive_group. Callbacks use the original coherent World and
+// cached geometry; this helper performs no SDK query and claims no bank receipt.
+template<class Policy,class Occupied,class NearestBank,class ReleaseHold,class Execute,class Recover>
+bool dispatch_loaded_capture_exit(LoadedCaptureExitMemory<Policy>& memory,const World& w,bool recovering,
+    Occupied&& occupied,NearestBank&& nearest_bank,ReleaseHold&& release_hold,Execute&& execute,Recover&& recover) {
+    if constexpr(!loaded_capture_exit_enabled<Policy>)return false;
+    else {
+        if(!w.self.alive||w.self.bag<=0) {memory.active=false;return false;}
+        if(w.self.channel!=Channel::none)return false;
+        // A quiet safe tile cannot cancel an existing recovery commitment.
+        // The caller clears recovery state on its normal at-spawn completion.
+        const bool continue_recovery=memory.active&&recovering&&
+            (!w.self.at_spawn||w.self.hp<.9*w.self.max_hp);
+        int altar=-1;
+        if(!memory.active) {
+            if(recovering||!w.safe_now||!w.capture_active)return false;
+            const auto* held=w.group(w.productive_group);
+            if(!held||!held->observed||!held->cleared||held->respawning||!occupied(*held))return false;
+            altar=nearest_bank();
+            if(altar<0)return false;
+            memory.active=true;
+        } else if(w.safe_now&&!continue_recovery)altar=nearest_bank();
+        // At most one current bank-route probe. Once selected, preserve the exit
+        // through later policy opportunities until the actual bag is empty.
+        release_hold();
+        if(continue_recovery||!w.safe_now||altar<0)recover();
+        else execute(bank(altar,"loaded actor exits enemy-blocked capture"));
+        return true;
+    }
+}
+} // namespace p9::live
