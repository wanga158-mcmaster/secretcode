+    // A successful spell can kill the selected member before the ordinary
+    // basic. Use at most that still-available basic on a fresh legal member of
+    // the same source; never add a spell, reset, movement or outside target.
+    void follow_up_basic(int source) {
+        if (cambc::fuel_remaining() < 25000) return;
+        auto& me = cambc::self();
+        if (!me.can_attack()) return;
+        const auto attacks = me.attack_tiles();
+        for (const auto& m : groups_[source].group.camps()) {
+            if (cambc::fuel_remaining() < 20000) return;
+            if (!m.is_visible()) continue;
+            const auto value = observe(m);
+            if (value.health > 0 && attacks.is_set({value.x, value.y})) {
+                me.attack(m); return;
+            }
+        }
+    }
