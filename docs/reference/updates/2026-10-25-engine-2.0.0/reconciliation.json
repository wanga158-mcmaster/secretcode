  "integrationDecisions": [
    {
      "observation": "The website engine2 preceded native CLI4; the later actual CLI4 download and fresh SDK4 expose 84 items and a new capture-state import.",
      "interpretation": "The temporary SDK3 bridge is not a native SDK4 oracle.",
      "decision": "Park the legacy bridge without running a bot game through it; use the real CLI4/SDK4 bundle.",
      "wouldChangeDecision": "A reproducible incompatibility in the pinned native bundle requires another isolated reconciliation, not guessed ABI compatibility."
    },
    {
      "observation": "Pinned native CLI4 and rebuilt fastrun match 140/140 keys on 70 pool maps, both sides; inputs unchanged and 140 native engine identities consistent.",
      "interpretation": "The runner is validated for the compared outcome, round, gem and recorded health-count fields on that panel.",
      "assumption": "Subsequent games use these same engine/runner/library bytes and SDK4-built subjects.",
      "decision": "Permit new-epoch regression work with explicit source/runtime bindings; inherit no old-epoch win qualification.",
      "wouldChangeDecision": "Any changed physical input or paired native discrepancy suspends this runner claim. This panel establishes no universal fuel equality, stall safety or bot strength."
    },
    {
      "observation": "SDK4 exposes item and passive states that some old pure models cannot represent, including five Adaptive build failures and strict Decision fixture failures.",
      "interpretation": "Successful compilation alone cannot establish a complete strategic observation or forecast.",
      "decision": "Repair catalog bounds and explicitly refuse unsupported forecasts while preserving each policy commitment; retain native health and model coverage as separate gaps.",
      "wouldChangeDecision": "An exact SDK4 mechanism witness and tested model of a new passive can replace an explicit unknown; a win alone cannot."
    },
    {
      "observation": "Source-only snapshot keys collide across SDK epochs; active old-runtime users still reference the shared installation.",
      "interpretation": "A direct rebuild can overwrite retained old inputs even though source identity is unchanged.",
      "decision": "Preserve the previous bundle, stage separate cache storage with shared coordination, and hold publication until old controllers are quiescent and the merged tools are tested.",
      "wouldChangeDecision": "Publication requires verified preservation, terminal-controller coordination and the tested merged cache path; elapsed time is not evidence of quiescence."
    }
