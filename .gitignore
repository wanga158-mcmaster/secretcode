# Local runtimes, caches and generated binaries
.cache/
.tools/
.cambc/
**/.cambc/
**/compile_commands.json
**/build/
**/target/
*.wasm
*.exe
*.dll
*.obj
*.pdb
*.o
*.a

# Match outputs and durable evidence (ladder log, online data, release bundles) stay local
replays/
results/*
!results/.gitkeep
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db

# Machine-local agent settings and account configuration
.claude/
.codex/
.agents/
.aws/
.ssh/
.azure/
.npmrc
.pypirc
.netrc
.git-credentials

# Environment files, private keys and credential payloads
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials.json
credentials.toml
credentials.yaml
credentials.yml
secrets.json
secrets.toml
secrets.yaml
secrets.yml
*.secrets.json
*.secrets.toml
*.secrets.yaml
*.secrets.yml

# Keep explicitly named, non-secret setup templates reviewable
!.env.example
!.env.sample
!.env.template
!.env.*.example
!*.key.example
!*.pem.example
!credentials.example.json
!credentials.example.toml
!credentials.example.yaml
!credentials.example.yml
!secrets.example.json
!secrets.example.toml
!secrets.example.yaml
!secrets.example.yml
